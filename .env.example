# Copier en .env et remplir si vous utilisez un modele reel.
# Par defaut le labo tourne avec MODEL_PROVIDER=mock (aucune cle, aucun cout, deterministe).

# mock | anthropic | ollama
MODEL_PROVIDER=mock

# --- Fournisseur API (anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Fournisseur local (ollama) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Plafond de cout par run en USD (securite anti-derapage). 0 = illimite.
BUDGET_USD=2.0

# Tracing optionnel (Langfuse). Laisser vide pour desactiver.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
